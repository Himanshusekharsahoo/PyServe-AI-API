# PyServe AI API Environment Configuration
IS_DEBUG=False
LOG_LEVEL=INFO

# Development only. Set a random secret (at least 32 characters) in production.
# API_KEY=

# Explicit browser origins allowed by CORS (comma-separated).
ALLOWED_ORIGINS=http://localhost:3000
ENVIRONMENT=development

# Path to the serialized sentiment analysis model artifact
DEFAULT_MODEL_PATH=models/sentiment.pkl

# Pre-deserialization SHA-256 cryptographic verification digest
EXPECTED_MODEL_SHA256=a37aa3bf39b864baef6bd0341a67fd67e941e084cd630f886d49f10ce49d3c9b

# Comma-separated trusted reverse proxy IPs (for client IP extraction)
# TRUSTED_PROXIES=127.0.0.1,10.0.0.1

# Operational rate limiting and payload constraints
RATE_LIMIT_PER_MINUTE=60
MAX_RATE_LIMIT_ENTRIES=10000
MAX_REQUEST_BYTES=65536